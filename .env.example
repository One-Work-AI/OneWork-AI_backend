# 이 파일을 복사해서 .env 로 이름을 바꾼 뒤 값을 수정하세요.
# 값을 바꾼 뒤에는 서버를 재시작해야 적용됩니다.
# 목록 값은 JSON 형식으로 적습니다. 예: ["a","b"]

# ── 데이터베이스 (팀 PostgreSQL) ──
# DB 폴더의 .env와 같은 값을 적습니다. 접속하려면 Tailscale이 켜져 있어야 합니다.
# 한 줄로 적고 싶으면 DATABASE_URL=postgresql+psycopg://user:password@host:port/db (적으면 아래 값보다 우선)
PGHOST=100.106.86.93
PGPORT=5433
PGDATABASE=cs_chatbot
PGUSER=cs_owner
PGPASSWORD=CHANGE_ME
PGSSLMODE=prefer

# ── 프론트엔드 주소 (CORS) — 브라우저에서 직접 호출할 때만 해당. Streamlit 서버에서 호출하면 상관없음 ──
CORS_ORIGINS=["http://localhost:8501","http://localhost:3000","http://localhost:5173"]

# ── 체험 입장 토큰 ──
# 반드시 길고 무작위한 값으로 바꾸세요. 예: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480

# ── 체험 입장 계정 — 팀 DB에 이미 있는 가상 계정을 그대로 씀 ──
# 고객은 이메일, 관리자는 login_id로 찾습니다. 없을 때만 scripts.seed_base 가 이름 값으로 새로 만듦 (빈 연습용 DB)
DEMO_CUSTOMER_EMAIL=demo@example.invalid
DEMO_CUSTOMER_NAME=테스트고객
DEMO_ADMIN_USERNAME=extra_demo_admin
DEMO_ADMIN_NAME=관리자

# ── AI 서버 ──
# mock: 백엔드 안의 가짜 AI (키워드 분류 + 키워드 검색 + 정책 문장으로 답변)
# http: AI 서버 호출. 주소는 AI 서버를 켠 PC — 같은 PC면 localhost, 다른 PC면 그 PC의 Tailscale 주소 (예: http://100.x.x.x:9000)
AI_MODE=mock
AI_SERVER_URL=http://localhost:9000
# AI 서버 형식 — chat: 팀 AI 서버(ddongzz/cs_chatbot)의 POST /chat (답변만 줌, 분류·신뢰도는 백엔드가 계산)
#               v1: docs/AI_SERVER_CONTRACT.md 형식 POST /v1/answer (분류·신뢰도까지 AI 서버가 줌)
AI_SERVER_FORMAT=chat
AI_TIMEOUT_SECONDS=120
# AI 서버에 함께 보낼 같은 채팅의 이전 메시지 개수 (0이면 안 보냄)
AI_HISTORY_MESSAGES=6

# ── 자동답변 판단 ──
# AI 서버가 준 신뢰도(카테고리·의도 중 작은 값)가 이 값 이상이면 챗봇이 자동답변, 미만이면 관리자 검토
# 신뢰도를 주지 않으면 검토로 갑니다. AI 서버 오류·빈 답변·정의되지 않은 유형도 항상 검토.
REVIEW_MIN_CONFIDENCE=0.8

# 추가 규칙 — 기본은 꺼짐. true로 바꾸면 신뢰도와 함께 적용 (하나라도 걸리면 검토)
REVIEW_LOW_RETRIEVAL_ENABLED=false
REVIEW_MIN_RETRIEVAL_SCORE=0.5
REVIEW_ALWAYS_INTENTS_ENABLED=false
REVIEW_ALWAYS_INTENTS=["결제 문제","환불받기","주문 취소"]
REVIEW_SHORT_ANSWER_ENABLED=false
REVIEW_MIN_ANSWER_CHARS=10

# 검토로 넘어갈 때 챗봇이 고객에게 남기는 안내 (입력은 계속 가능, 상담원 답변은 같은 채팅에 붙음)
REVIEW_NOTICE_MESSAGE=확인이 필요한 내용이라 담당자에게 전달했어요. 답변이 오면 이 채팅에서 알려드릴게요. 다른 궁금한 점은 계속 물어보셔도 돼요.

# ── 채팅 자동 종료 ──
# 챗봇·상담원 답변 후 고객이 이 시간(분) 동안 말이 없으면 상담 종료. AI 처리 중·검토 대기 중인 질문이 있으면 멈춤
CHAT_IDLE_TIMEOUT_MINUTES=5
# 자동 종료 대상을 확인하는 주기(초). 0이면 백그라운드 확인을 끄고, 고객이 채팅을 조회할 때만 확인
CHAT_TIMEOUT_SWEEP_SECONDS=30

# ── 주문 정보 ──
# team: 팀 DB의 orders / order_item
ORDER_SOURCE=team

# ── 정책 문서 (PDF) ──
CHUNK_MAX_CHARS=500
POLICY_FILE_DIR=storage/policies
POLICY_MAX_MB=200

# ── AI 답변의 빈칸({{…}}) 채우기 ──
# 고객 이름·주문번호·배송·결제·환불 정보는 팀 DB에서 채웁니다 (고객의 가장 최근 주문 기준).
# {{Website URL}}에 넣을 쇼핑몰 주소. 비우면 그 빈칸은 못 채워서 관리자 검토로 갑니다.
SITE_URL=

# ── 문의번호 ──  예: Q20261001-001 (채팅 1개 = 문의번호 1개, 날짜는 한국 시간 기준)
INQUIRY_NO_PREFIX=Q
